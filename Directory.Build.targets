<Project>
  <!--
    Reference switch for our own packages.

    A project references another package of this repo the way a consumer would:
      <PackageReference Include="Ave.Extensions.X" />
    with the minimum version in Directory.Packages.props (VersionOverride where a project needs a newer one).

    UseRepoProjectReferences=true (default, local and CI head builds): every such PackageReference for which
    libs/*/<PackageId>/<PackageId>.csproj exists is replaced by a ProjectReference to that project, so the
    whole repo builds and tests against its own head.

    UseRepoProjectReferences=false (release): the PackageReference stays, so the packed nuspec carries the
    published minimum and a global -p:Version cannot leak into another package.
  -->
  <ItemGroup Condition="'$(UseRepoProjectReferences)' == 'true'">
    <_AveRepoProject Include="$(MSBuildThisFileDirectory)libs/*/Ave.Extensions.*/Ave.Extensions.*.csproj" ProjectPath="%(FullPath)" />
    <_AveRepoPackage Include="@(_AveRepoProject->'%(Filename)')" />
    <_AveRepoPackageNotReferenced Include="@(_AveRepoPackage)" Exclude="@(PackageReference)" />
    <_AveRepoPackageReferenced Include="@(_AveRepoPackage)" Exclude="@(_AveRepoPackageNotReferenced)" />

    <PackageReference Remove="@(_AveRepoPackageReferenced)" />
    <ProjectReference Include="@(_AveRepoPackageReferenced->'%(ProjectPath)')" />

    <_AveRepoProject Remove="@(_AveRepoProject)" />
    <_AveRepoPackage Remove="@(_AveRepoPackage)" />
    <_AveRepoPackageNotReferenced Remove="@(_AveRepoPackageNotReferenced)" />
    <_AveRepoPackageReferenced Remove="@(_AveRepoPackageReferenced)" />
  </ItemGroup>

  <!--
    Test switch: run the net10.0 test projects against the netstandard2.0 asset (-p:UseNs20=true).

    Applies to UnitTests.*, IntegrationTests.* and PlatformTests.* projects, unless the project sets
    <Ns20AssetUnderTest>false</Ns20AssetUnderTest> because the library it tests has no netstandard2.0 asset.

    Every project reference (direct or transitive) that targets netstandard2.0 gets
    SetTargetFramework=TargetFramework=netstandard2.0, so the test builds and runs against that asset.
    NuGet restore does not see SetTargetFramework: it restores the net10.0 dependencies of the referenced
    projects. Packages that only the netstandard2.0 asset needs, and that are not part of the net10.0 shared
    framework, are therefore added to the test project here.

    eng/Ns20AssetCheck.cs is compiled into the test project: test NS20-001 fails unless every Ave.Extensions
    library the test assembly loads is the netstandard2.0 asset.
  -->
  <PropertyGroup>
    <_AveIsTestProject Condition="$(MSBuildProjectName.StartsWith('UnitTests.')) or $(MSBuildProjectName.StartsWith('IntegrationTests.')) or $(MSBuildProjectName.StartsWith('PlatformTests.'))">true</_AveIsTestProject>
    <_AveTestOnNs20 Condition="'$(UseNs20)' == 'true' and '$(_AveIsTestProject)' == 'true' and '$(Ns20AssetUnderTest)' != 'false'">true</_AveTestOnNs20>
  </PropertyGroup>

  <ItemGroup Condition="'$(_AveTestOnNs20)' == 'true'">
    <!-- Referenced by the netstandard2.0 assets of the file-system family (IAsyncDisposable) -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <Compile Include="$(MSBuildThisFileDirectory)eng/Ns20AssetCheck.cs" Link="Ns20AssetCheck.cs" />
  </ItemGroup>

  <Target Name="_AveUseNetStandard20Assets"
          BeforeTargets="_GetProjectReferenceTargetFrameworkProperties"
          Condition="'$(_AveTestOnNs20)' == 'true' and '@(_MSBuildProjectReferenceExistent)' != ''">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="GetTargetFrameworks"
             BuildInParallel="$(BuildInParallel)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
             SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs" ItemName="_AveReferenceTargetFrameworks" />
    </MSBuild>

    <ItemGroup>
      <_AveNs20Reference Include="@(_AveReferenceTargetFrameworks)"
                         Condition="$([System.String]::Copy(';%(_AveReferenceTargetFrameworks.TargetFrameworks);').Contains(';netstandard2.0;'))" />
    </ItemGroup>
    <PropertyGroup>
      <_AveNs20ReferencePaths>;@(_AveNs20Reference->'%(FullPath)');</_AveNs20ReferencePaths>
    </PropertyGroup>
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Condition="$(_AveNs20ReferencePaths.Contains(';%(_MSBuildProjectReferenceExistent.FullPath);'))">
        <SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
      </_MSBuildProjectReferenceExistent>
      <_AveReferenceTargetFrameworks Remove="@(_AveReferenceTargetFrameworks)" />
      <_AveNs20Reference Remove="@(_AveNs20Reference)" />
    </ItemGroup>
  </Target>

  <!--
    Release tag name of a package: <tag name>/<version>, e.g. functional-core/0.1.0-preview.4.
    Rule: the package id without "Ave.Extensions.", lower case, words split by hyphens
    (Ave.Extensions.ErrorPaths.AspNetCore -> error-paths-asp-net-core).
    A project can override it with <ReleaseTagName>. eng/release-tags.proj prints the table and checks
    that every name is unique.
  -->
  <Target Name="GetReleaseTag" Returns="@(_AveReleaseTag)" Condition="'$(IsPackable)' == 'true'">
    <PropertyGroup>
      <_AveReleaseTagBase>$(PackageId)</_AveReleaseTagBase>
      <_AveReleaseTagBase Condition="$(_AveReleaseTagBase.StartsWith('Ave.Extensions.'))">$(_AveReleaseTagBase.Substring(15))</_AveReleaseTagBase>
      <_AveReleaseTagName>$(ReleaseTagName)</_AveReleaseTagName>
      <_AveReleaseTagName Condition="'$(_AveReleaseTagName)' == ''">$([System.Text.RegularExpressions.Regex]::Replace($(_AveReleaseTagBase), '(?&lt;=[a-z0-9])(?=[A-Z])|(?&lt;=[A-Z])(?=[A-Z][a-z])', '-').Replace('.', '-').ToLowerInvariant())</_AveReleaseTagName>
    </PropertyGroup>
    <ItemGroup>
      <_AveReleaseTag Include="$(_AveReleaseTagName)" PackageId="$(PackageId)" ProjectPath="$(MSBuildProjectFullPath)" />
    </ItemGroup>
  </Target>

  <!--
    The package a test project tests, for the release of that package (eng/release-tags.proj, target ResolveRelease).
    Rule: UnitTests.Extensions.X tests Ave.Extensions.X. Other test projects set <TestedPackageId>.

    A release runs the tests in release mode (UseRepoProjectReferences=false), so they test the package under test
    against the published minimum versions of the packages below it. A test project sets
    <TestInHeadMode>true</TestInHeadMode> when that cannot work: it needs another package of this repository that
    itself depends on the package under test, and in release mode that package brings the published version of the
    package under test next to the one being built (CS1704). The release runs such a project in head mode.
  -->
  <Target Name="GetTestedPackage" Returns="@(_AveTestedPackage)" Condition="'$(_AveIsTestProject)' == 'true'">
    <PropertyGroup>
      <_AveTestedPackageId>$(TestedPackageId)</_AveTestedPackageId>
      <_AveTestedPackageId Condition="'$(_AveTestedPackageId)' == '' and $(MSBuildProjectName.StartsWith('UnitTests.Extensions.'))">Ave.Extensions.$(MSBuildProjectName.Substring(21))</_AveTestedPackageId>
      <_AveTestInHeadMode>false</_AveTestInHeadMode>
      <_AveTestInHeadMode Condition="'$(TestInHeadMode)' == 'true'">true</_AveTestInHeadMode>
    </PropertyGroup>
    <ItemGroup>
      <_AveTestedPackage Include="$(MSBuildProjectFullPath)" PackageId="$(_AveTestedPackageId)" TestInHeadMode="$(_AveTestInHeadMode)" />
    </ItemGroup>
  </Target>
</Project>
