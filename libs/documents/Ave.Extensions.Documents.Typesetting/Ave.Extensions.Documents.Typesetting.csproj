<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: the engine is written for .NET 10 and has no netstandard build (README.md, "Target framework") -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageTags>pdf;pdf-a;pdf-ua;document;layout;typesetting</PackageTags>
    <Description>Text processing for the Ave.Extensions.Documents engine: white-space collapsing, shaping (characters to positioned glyphs) and line breaking.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ave.Extensions.Documents.Core" />
    <PackageReference Include="Ave.Extensions.Documents.Fonts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests.Extensions.Documents.Typesetting" />
  </ItemGroup>

</Project>
