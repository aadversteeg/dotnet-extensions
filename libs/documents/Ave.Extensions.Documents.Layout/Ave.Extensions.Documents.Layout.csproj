<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: the engine is written for .NET 10 and has no netstandard build (README.md, "Target framework") -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageTags>pdf;pdf-a;pdf-ua;document;layout;typesetting</PackageTags>
    <Description>Layout for the Ave.Extensions.Documents engine: pure layout algorithms (block flow, inline text), pagination, and painting into the page model.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ave.Extensions.Documents.Core\Ave.Extensions.Documents.Core.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Fonts\Ave.Extensions.Documents.Fonts.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Typesetting\Ave.Extensions.Documents.Typesetting.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.DocumentModel\Ave.Extensions.Documents.DocumentModel.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.PageModel\Ave.Extensions.Documents.PageModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests register small algorithms of their own (WithAlgorithm is internal). -->
    <InternalsVisibleTo Include="UnitTests.Extensions.Documents.Layout" />
  </ItemGroup>

</Project>
