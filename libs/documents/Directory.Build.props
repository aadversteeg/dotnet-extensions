<Project>
  <!-- Shared settings for every project in this repository (same shape as extensions-functional). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Output must not depend on the machine's culture (numbers in PDF and in the text serialisations). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- Code-style rules from .editorconfig (unused usings, file-scoped namespaces) are checked by the build. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The rule "no native code anywhere": our own assemblies may never contain unsafe code. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <Authors>Aad Versteeg</Authors>
    <Company>Versteeg IT Solutions</Company>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>

    <!-- Packages (the 11 product libraries; see the IsPackable group below for what is never packed). Same shape as
         the Ave.Extensions libraries, with two differences: there is no repository URL (the repository has no remote
         yet), and there is no licence expression (the licence is still to be decided), so every description says the
         package is not for redistribution (Directory.Build.targets adds that sentence). -->
    <PackageId>$(MSBuildProjectName)</PackageId>
    <Copyright>Copyright © Versteeg IT Solutions 2026</Copyright>
    <PackageTags>pdf;pdf-a;pdf-ua;document;layout;typesetting</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Symbols as the Ave.Extensions libraries publish them: a .snupkg next to every .nupkg. Without a remote there
         is no source link to resolve, so the symbols carry the sources themselves. -->
    <DebugSymbols>true</DebugSymbols>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedAllSources>true</EmbedAllSources>

    <!-- Root of the repository, used to find shared assets such as the test fonts. -->
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
  </PropertyGroup>

  <!-- Test projects (UnitTests.*) and the samples are never packed and need no XML docs on their members. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('UnitTests.')) Or '$(IsSampleOrSupport)' == 'true'">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Every test project gets the same test packages; its .csproj only lists the projects it tests. -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('UnitTests.'))">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
  </ItemGroup>
</Project>
