<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: the engine is written for .NET 10 and has no netstandard build (README.md, "Target framework") -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageTags>pdf;pdf-a;pdf-ua;document;layout;typesetting</PackageTags>
    <Description>The Ave.Extensions.Documents engine in one package: the code front-end, layout and the PDF back-end, joined by one call (ToPdf). Reference this to build a document in C# and get a PDF; reference the layer packages to use or replace one layer.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ave.Extensions.Documents.Fluent\Ave.Extensions.Documents.Fluent.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Layout\Ave.Extensions.Documents.Layout.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Render.Pdf\Ave.Extensions.Documents.Render.Pdf.csproj" />
  </ItemGroup>

</Project>
