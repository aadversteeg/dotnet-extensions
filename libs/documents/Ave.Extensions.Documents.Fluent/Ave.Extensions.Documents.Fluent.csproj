<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: the engine is written for .NET 10 and has no netstandard build (README.md, "Target framework") -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageTags>pdf;pdf-a;pdf-ua;document;layout;typesetting</PackageTags>
    <Description>The code front-end of the Ave.Extensions.Documents engine: build a document as an immutable value from plain C# function calls and translate it into the document model. Rendering it to PDF is in the Ave.Extensions.Documents package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ave.Extensions.Documents.Core\Ave.Extensions.Documents.Core.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Fonts\Ave.Extensions.Documents.Fonts.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Images\Ave.Extensions.Documents.Images.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.DocumentModel\Ave.Extensions.Documents.DocumentModel.csproj" />
  </ItemGroup>

</Project>
