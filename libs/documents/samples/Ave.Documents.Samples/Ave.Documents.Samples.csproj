<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsSampleOrSupport>true</IsSampleOrSupport>
    <!-- No native app host: the publish folder then holds managed assemblies only (proved by tools/verify-samples.ps1).
         Run with `dotnet Ave.Documents.Samples.dll <output folder>`. -->
    <UseAppHost>false</UseAppHost>
    <!-- The timesheet formats numbers in the reader's culture (nl-NL, en-US) — .NET formatting in the template, not in
         the engine — so this app needs the culture data the libraries do without. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ave.Documents.Fluent\Ave.Documents.Fluent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepositoryRoot)assets/fonts/lato/*.ttf;$(RepositoryRoot)assets/fonts/lato/OFL.txt" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The reporting PoC's sample data (copied from /d/dev/ave/reporting-poc/data, commit 4cce9bf) and its logo as PNG
         (made by tools/generate-test-images.py). -->
    <None Include="data/*.json;assets/logo.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
