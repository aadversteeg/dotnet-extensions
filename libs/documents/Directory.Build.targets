<Project>
  <!-- Evaluated after each project file, so the project's own Description is already set here. -->

  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <!-- No licence expression yet (Aad decides the licence later): until then every package says it may not be passed on. -->
    <Description>$(Description) Preview for private use: not licensed for redistribution.</Description>
  </PropertyGroup>

  <!-- Every package carries the README and the notice (what the code was written from, the third-party data and fonts). -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(RepositoryRoot)NOTICE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The Unicode property table in Typesetting is generated from the Unicode Character Database, whose licence asks for
       its notice to travel with data derived from it. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Ave.Extensions.Documents.Typesetting'">
    <None Include="$(RepositoryRoot)assets/unicode/18.0.0/LICENSE.txt" Pack="true" PackagePath="licenses/Unicode-LICENSE.txt" Visible="false" />
  </ItemGroup>
</Project>
