<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- nuget.org for public packages; the fleet's local feed (%JASMIN_LOCAL_FEED%) for Ave.* packages that are
       not on nuget.org. Same shape as the smallbusiness repository. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local" value="%JASMIN_LOCAL_FEED%" />
  </packageSources>
</configuration>
