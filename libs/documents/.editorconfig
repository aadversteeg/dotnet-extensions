root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space

[*.cs]
indent_size = 4
# Unused using directives fail the build (with EnforceCodeStyleInBuild in Directory.Build.props).
dotnet_diagnostic.IDE0005.severity = warning
csharp_style_namespace_declarations = file_scoped:warning

[*.{csproj,props,targets,slnx,json,yml,yaml}]
indent_size = 2
