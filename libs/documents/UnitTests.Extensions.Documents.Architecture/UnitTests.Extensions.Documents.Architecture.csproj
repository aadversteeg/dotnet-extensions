<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Suppress XML documentation warnings for test projects -->
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- The engine targets net10.0 only: -p:UseNs20=true and -p:UseNs21=true do not apply here -->
    <Ns20AssetUnderTest>false</Ns20AssetUnderTest>
    <!-- The rules of the whole family, checked on every library together. A release of the composition package
         runs them; in head mode, because they load the head build of every library next to each other. -->
    <TestedPackageId>Ave.Extensions.Documents</TestedPackageId>
    <TestInHeadMode>true</TestInHeadMode>
    <!-- Output must not depend on the machine's culture (numbers in PDF and in the text serialisations) -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
  </ItemGroup>

  <!-- Checks the compiled library assemblies themselves: no native code, and every layer depends only on the
       layers below it. References every library so that all of them are copied next to the tests. -->
  <ItemGroup>
    <ProjectReference Include="..\Ave.Extensions.Documents\Ave.Extensions.Documents.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Typesetting\Ave.Extensions.Documents.Typesetting.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Pdf\Ave.Extensions.Documents.Pdf.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Html.Parsing\Ave.Extensions.Documents.Html.Parsing.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Css\Ave.Extensions.Documents.Css.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Html\Ave.Extensions.Documents.Html.csproj" />
    <!-- Build order only: the positive control of the test-only-package rule reads the reference shaper's test
         assembly from that project's output folder, so that project is built first (neither its assembly nor its files
         are copied here). -->
    <ProjectReference Include="..\UnitTests.Extensions.Documents.Typesetting\UnitTests.Extensions.Documents.Typesetting.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
