<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the compiled library assemblies themselves: no native code, and every layer depends only on the
       layers below it. References every library so that all of them are copied next to the tests. -->
  <ItemGroup>
    <ProjectReference Include="..\Ave.Extensions.Documents\Ave.Extensions.Documents.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Typesetting\Ave.Extensions.Documents.Typesetting.csproj" />
    <ProjectReference Include="..\Ave.Extensions.Documents.Pdf\Ave.Extensions.Documents.Pdf.csproj" />
    <!-- Build order only: the positive control of the test-only-package rule reads the reference shaper's test
         assembly from that project's output folder, so that project is built first (neither its assembly nor its files
         are copied here). -->
    <ProjectReference Include="..\UnitTests.Extensions.Documents.Typesetting\UnitTests.Extensions.Documents.Typesetting.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
