<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: the engine is written for .NET 10 and has no netstandard build (README.md, "Target framework") -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageTags>pdf;pdf-a;pdf-ua;document;layout;typesetting</PackageTags>
    <Description>A TrueType font reader in plain managed code: the tables a document engine needs to map text to glyphs, measure it and embed the font.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ave.Extensions.Documents.Core\Ave.Extensions.Documents.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests.Extensions.Documents.Fonts" />
    <InternalsVisibleTo Include="UnitTests.Extensions.Documents.Typesetting" />
  </ItemGroup>

</Project>
