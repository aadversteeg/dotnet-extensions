<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: the engine is written for .NET 10 and has no netstandard build (README.md, "Target framework") -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageTags>pdf;pdf-a;pdf-ua;document;layout;typesetting</PackageTags>
    <Description>Shared vocabulary of the Ave.Extensions.Documents engine: typed lengths, geometry, colour, source locations, semantic roles and the error-code tree.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ave.Extensions.Functional" />
    <PackageReference Include="Ave.Extensions.Functional.Core" />
    <PackageReference Include="Ave.Extensions.ErrorPaths" />
    <PackageReference Include="Ave.Extensions.ErrorPaths.Functional" />
  </ItemGroup>

</Project>
