<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: the engine is written for .NET 10 and has no netstandard build (README.md, "Target framework") -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageTags>html;parser;html5;document</PackageTags>
    <Description>The HTML Standard's parsing algorithm in plain managed code: tokenizer, tree construction (scripting off, foreign content, templates, fragments) and an immutable tree with source positions and parse errors.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ave.Extensions.Documents.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- HTML Standard §13.5: the named character references, generated by tools/generate-html-entities.py -->
    <EmbeddedResource Include="Tokenizing/named-character-references.txt" LogicalName="Ave.Extensions.Documents.Html.Parsing.named-character-references.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests.Extensions.Documents.Html.Parsing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The diagnostics' quoting rule, one source for the three front-end packages. -->
    <Compile Include="..\Shared\InputQuote.cs" Link="InputQuote.cs" />
  </ItemGroup>

</Project>
