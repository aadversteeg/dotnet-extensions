<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 only: the engine is written for .NET 10 and has no netstandard build (README.md, "Target framework") -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <PackageTags>pdf;pdf-a;pdf-ua;document;layout;typesetting</PackageTags>
    <Description>Image coding in plain managed code: PNG decoded to samples and encoded deterministically, JPEG read for its size and colour space so it can be embedded unchanged, or decoded to samples (baseline and progressive).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ave.Extensions.Documents.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests.Extensions.Documents.Images" />
  </ItemGroup>

</Project>
