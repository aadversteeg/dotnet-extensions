<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>8</LangVersion>
    <IsPackable>true</IsPackable>
    <Description>FluentAssertions extensions for functional programming types</Description>
    <PackageTags>functional;fluentassertions;testing;maybe;result;option</PackageTags>
    <!-- Suppress XML documentation warnings -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ave.Extensions.Functional" VersionOverride="0.1.0-preview.3" />
  </ItemGroup>

</Project>