<Project>
  <!-- Import the repository Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  
  <!-- Override properties for sample applications -->
  <PropertyGroup>
    <!-- Sample apps don't need documentation generation -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>