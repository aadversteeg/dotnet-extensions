<Project>
  <!-- Import the repository Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  
  <!-- Override properties for sample applications -->
  <PropertyGroup>
    <!-- Sample apps don't need documentation generation -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  
  <!-- Remove Source Link for sample applications (not needed for executables) -->
  <ItemGroup>
    <PackageReference Remove="Microsoft.SourceLink.GitHub" />
  </ItemGroup>
</Project>