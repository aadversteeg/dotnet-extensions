{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Extensions.Hosting": "Information",
      "FileSystemSamples": "Debug"
    },
    "Console": {
      "IncludeScopes": false,
      "TimestampFormat": "HH:mm:ss.fff "
    }
  },
  "ErrorHandling": {
    "MaxRetries": 3,
    "InitialRetryDelayMs": 100,
    "RetryMultiplier": 2.0,
    "MaxRetryDelayMs": 5000,
    "ContinueOnError": true
  },
  "Performance": {
    "MemoryWarningThresholdMB": 500,
    "ProgressUpdateIntervalMs": 1000,
    "MaxConcurrentOperations": 10,
    "StreamingExportBatchSize": 1000
  },
  "Export": {
    "DefaultFormat": "Text",
    "CreateBackups": false,
    "MaxFileSizeMB": 100,
    "CompressionEnabled": false
  }
}