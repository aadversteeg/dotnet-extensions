<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Ave.Extensions.FileSystem.AzureStorage</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>Ave</Authors>
    <Description>Azure Storage implementation for Ave.Extensions.FileSystem</Description>
    <PackageTags>filesystem;azure;storage;file-share</PackageTags>
    <RepositoryUrl>https://github.com/aadversteeg/ave.extensions.filesystem</RepositoryUrl>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Files.Shares" Version="12.22.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" />
  </ItemGroup>
  
  <!-- Override SourceLink to specify version explicitly since we're not using central package management -->
  <ItemGroup>
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="1.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ave.Extensions.FileSystem.Abstractions\Ave.Extensions.FileSystem.Abstractions.csproj" />
    <ProjectReference Include="..\Ave.Extensions.FileSystem\Ave.Extensions.FileSystem.csproj" />
    <ProjectReference Include="..\Ave.Extensions.FileSystem.Local\Ave.Extensions.FileSystem.Local.csproj" />
  </ItemGroup>

</Project>