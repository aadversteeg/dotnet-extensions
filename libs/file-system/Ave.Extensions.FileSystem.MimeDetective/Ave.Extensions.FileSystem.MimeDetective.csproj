<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.1 until the netstandard2.0 port of file-system is done -->
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    
    <!-- Package specific metadata -->
    <Description>MIME type detection extension for Ave.Extensions.FileSystem using MimeDetective library.</Description>
    <PackageTags>filesystem;io;mime;file-type;detection;mime-detective</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ave.Extensions.FileSystem.Abstractions" />
    <PackageReference Include="Ave.Extensions.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Mime-Detective" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

</Project>