<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    
    <!-- Package specific metadata -->
    <Description>Cross-platform file system operations for Windows and Linux.</Description>
    <PackageTags>filesystem;io;cross-platform</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ave.Extensions.FileSystem.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <!-- System.Threading.Channels and IAsyncEnumerable are in-box on net10.0; netstandard2.0 needs the packages. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="System.Threading.Channels" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests.Extensions.FileSystem" />
  </ItemGroup>

</Project>