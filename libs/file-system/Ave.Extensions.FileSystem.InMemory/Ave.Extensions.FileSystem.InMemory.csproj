<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    
    <!-- Package specific metadata -->
    <Description>In-memory implementation for Ave.Extensions.FileSystem for testing and development.</Description>
    <PackageTags>filesystem;inmemory;testing;development;mock</PackageTags>
    <IsPackable>true</IsPackable>

    <!-- netstandard2.1 as well: there the write stream overrides Stream.DisposeAsync, so .NET Core 3.0 up to
         .NET 9 get a real asynchronous dispose. netstandard2.0 has no Stream.DisposeAsync to override. -->
    <TargetFrameworks>netstandard2.0;netstandard2.1;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Ave.Extensions.FileSystem.Abstractions" />
    <PackageReference Include="Ave.Extensions.FileSystem" />
  </ItemGroup>

  <!-- IAsyncDisposable is in-box on netstandard2.1 and net10.0; netstandard2.0 needs the package -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

</Project>