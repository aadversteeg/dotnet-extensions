<Project>
  <PropertyGroup>
    <!-- Common properties for all projects -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Code-style rules that .editorconfig sets to warning fail the build (today only libs/documents sets any) -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- References to our own packages: true = ProjectReference to the project in this repo (local and CI
         head builds), false = PackageReference to the minimum version in Directory.Packages.props (release).
         The switch itself lives in Directory.Build.targets. -->
    <UseRepoProjectReferences Condition="'$(UseRepoProjectReferences)' == ''">true</UseRepoProjectReferences>

    <!-- Test switches: -p:UseNs20=true runs the net10.0 test projects against the netstandard2.0 asset of our
         libraries instead of the net10.0 one. -p:UseNs21=true runs them against the netstandard2.1 asset where
         a library has one, otherwise the netstandard2.0 asset. Use one at a time. The switches themselves live
         in Directory.Build.targets. -->
    <UseNs20 Condition="'$(UseNs20)' == ''">false</UseNs20>
    <UseNs21 Condition="'$(UseNs21)' == ''">false</UseNs21>

    <!-- The version comes from the release tag (-p:Version); local builds are 0.0.0-dev -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>

    <!-- Package information -->
    <Authors>Aad Versteeg</Authors>
    <Company>Versteeg IT Solutions</Company>
    <Copyright>Copyright © Versteeg IT Solutions $([System.DateTime]::Now.Year)</Copyright>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/aadversteeg/dotnet-extensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/aadversteeg/dotnet-extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Source Link comes with the .NET SDK: no package reference. A package reference would put its build-time
         dependencies (System.Memory and others) into the netstandard2.0 compile graph of every library. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- On GitHub Actions: deterministic source paths (/_/...) in the PDBs of the libraries. Not for tests, samples
         and tools: their [CallerFilePath] values must stay real paths, because tests find their golden files and test
         data next to their source with them. -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' and $(MSBuildProjectName.StartsWith('Ave.Extensions.'))">true</ContinuousIntegrationBuild>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Libraries (Ave.Extensions.*) target netstandard2.0 and net10.0 unless the project overrides
       TargetFrameworks. Everything else (tests, benchmarks, samples) targets net10.0. -->
  <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('Ave.Extensions.'))">
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="!$(MSBuildProjectName.StartsWith('Ave.Extensions.'))">
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Every package carries the README of its family (libs/<family>/README.md) and the repository LICENSE, and the
       family's NOTICE.md when it has one (third-party data and fonts, what the code was written from) -->
  <ItemGroup Condition="$(MSBuildProjectName.StartsWith('Ave.Extensions.'))">
    <None Include="$(MSBuildProjectDirectory)/../README.md" Pack="true" PackagePath="\" Visible="false"/>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false"/>
    <None Include="$(MSBuildProjectDirectory)/../NOTICE.md" Condition="Exists('$(MSBuildProjectDirectory)/../NOTICE.md')" Pack="true" PackagePath="\" Visible="false"/>
  </ItemGroup>
</Project>
